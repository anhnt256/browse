+    // An older extension that never sends idleMinutes leaves the stored value alone.
+    relay.apply_extension_settings(&link, &json!({ "humanInput": "on" }));
+    assert_eq!(link.idle_minutes(), Some(0));
+    // The sweep sees the setting once the link is the default browser.
+    relay.st().links.push(link.clone());
+    assert_eq!(
+        relay.effective_idle_ttl(),
+        None,
+        "idleMinutes never disables the sweep"
+    );
+    relay.apply_extension_settings(&link, &json!({ "idleMinutes": 30 }));
+    assert_eq!(relay.effective_idle_ttl(), Some(Duration::from_secs(1800)));
+    let _ = std::fs::remove_dir_all(&paths.data);
+}
